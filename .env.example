# Copy this file to .env.dev or .env.prod and replace every placeholder.
# The npm scripts set NODE_ENV before the application starts.

NODE_ENV=dev

PORT=3000
MONGO_URI=mongodb://localhost:27017/socialMediaApp
MONGO_URI_PROD=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/<database>?retryWrites=true&w=majority
MOOD=dev
SALT=10

JWT_KEY=replace-with-a-random-secret
JWT_USER_SIGNATURE=replace-with-a-user-access-secret
JWT_ADMIN_SIGNATUER=replace-with-an-admin-access-secret
JWT_USER_REFRESH_SIGNATURE=replace-with-a-user-refresh-secret
JWT_ADMIN_REFRESH_SIGNATURE=replace-with-an-admin-refresh-secret

BASE_URL=http://localhost:3000
REDIS_URI=redis://localhost:6379

APP_EMAIL=your-email@example.com
APP_PASSWORD=your-gmail-app-password

CLOUDINARY_URL=cloudinary://<api-key>:<api-secret>@<cloud-name>
